# Copy to .env and fill in your Flyte deployment values.
# Never commit .env — it may contain secrets.

# --- Required for Node examples (client_credentials) ---
FLYTE_ENDPOINT=https://my-flyte.example.com
FLYTE_ORG=my-org
FLYTE_PROJECT=my-project
FLYTE_DOMAIN=development
FLYTE_API_KEY=

# Optional: task name for run examples (default: my_task)
FLYTE_TASK=my_task

# --- Optional: OAuth client credentials instead of API key ---
# FLYTE_CLIENT_ID=
# FLYTE_CLIENT_SECRET=

# --- Optional: config-file examples and e2e tests ---
# Path to a flytectl/uctl-style config file. When unset, the standard
# locations are searched (~/.flyte/config.yaml and friends).
# FLYTE_CONFIG=

# Task environment the e2e fixture tasks are deployed under.
# FLYTE_E2E_ENV=sdk_ts_e2e

# --- Browser demo only (see examples/README.md) ---
# Local dev host: localhost.<admin-host> (add to /etc/hosts → 127.0.0.1)
FLYTE_DEMO_HOST=localhost.my-flyte.example.com
FLYTE_ADMIN_HOST=my-flyte.example.com
# FLYTE_DEMO_PORT=8080

# Vite reads VITE_* from repo root .env
VITE_FLYTE_ENDPOINT=https://my-flyte.example.com
VITE_FLYTE_ORG=my-org
VITE_FLYTE_PROJECT=my-project
VITE_FLYTE_DOMAIN=development
VITE_FLYTE_TASK=my_task
